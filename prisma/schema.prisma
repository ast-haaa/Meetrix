datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

// ------------------------------------------------------
// Multi-Tenancy & Workspace Scope
// ------------------------------------------------------

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users        UserOrganization[]
  projects     Project[]
  meetings     Meeting[]
  owners       Owner[]
  integrations IntegrationSetting[]
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String?
  avatarUrl     String?
  role          String   @default("MEMBER") // "ADMIN", "MEMBER"
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  organizations UserOrganization[]
  assignedItems ActionItem[]        @relation("AssignedActions")
  createdItems  ActionItem[]        @relation("CreatedActions")
  ownerProfile  Owner?
}

model UserOrganization {
  id             String       @id @default(cuid())
  userId         String
  organizationId String
  role           String       @default("MEMBER")

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
}

model Project {
  id             String   @id @default(cuid())
  name           String
  description    String?
  organizationId String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  meetings     Meeting[]
  decisions    Decision[]
}

// ------------------------------------------------------
// Admin Audit Logs
// ------------------------------------------------------

model AdminAuditLog {
  id             String   @id @default(cuid())
  adminName      String
  action         String   // "RETRIGGER_JOB", "MERGE_DECISION", "REVOKE_INTEGRATION", "DELETE_MEETING"
  targetResource String
  details        String
  createdAt      DateTime @default(now())
}

// ------------------------------------------------------
// Integration Credentials (Encrypted at rest)
// ------------------------------------------------------

model IntegrationSetting {
  id                 String   @id @default(cuid())
  organizationId     String
  provider           String   // "SLACK", "JIRA", "LINEAR"
  encryptedWebhookUrl String?
  encryptedHostUrl   String?
  encryptedUserEmail String?
  encryptedApiToken  String?
  enabled            Boolean  @default(true)

  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([organizationId, provider])
}

// ------------------------------------------------------
// Owners & Participants
// ------------------------------------------------------

model Owner {
  id             String   @id @default(cuid())
  organizationId String
  userId         String?  @unique
  name           String
  email          String?
  avatarUrl      String?
  role           String   @default("MEMBER") // "ADMIN", "MEMBER"

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  
  speakers     MeetingSpeaker[]
  actionItems  ActionItem[]  @relation("OwnerActionItems")

  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

// ------------------------------------------------------
// Meetings & Transcripts
// ------------------------------------------------------

model Meeting {
  id              String        @id @default(cuid())
  organizationId  String
  projectId       String?
  title           String
  description     String?
  scheduledAt     DateTime?
  durationSeconds Int?
  audioUrl        String?
  status          String        @default("UPLOADING")
  processingError String?

  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project        Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)

  transcriptUtterances TranscriptUtterance[]
  speakers             MeetingSpeaker[]
  decisions            Decision[]            @relation("MeetingDecisions")
  actionItems          ActionItem[]          @relation("MeetingActionItems")
  
  followThroughReviews FollowThroughTracking[] @relation("ReviewingMeeting")

  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

model MeetingSpeaker {
  id           String  @id @default(cuid())
  meetingId    String
  speakerLabel String
  ownerId      String?

  meeting    Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  owner      Owner?  @relation(fields: [ownerId], references: [id], onDelete: SetNull)

  utterances TranscriptUtterance[]

  @@unique([meetingId, speakerLabel])
}

model TranscriptUtterance {
  id        String   @id @default(cuid())
  meetingId String
  speakerId String?
  startTime Float
  endTime   Float
  text      String
  sequence  Int

  meeting Meeting         @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  speaker MeetingSpeaker? @relation(fields: [speakerId], references: [id], onDelete: SetNull)

  @@index([meetingId, sequence])
}

// ------------------------------------------------------
// Decisions & Action Items
// ------------------------------------------------------

model Decision {
  id              String         @id @default(cuid())
  projectId       String?
  originMeetingId String
  title           String
  context         String
  rationale       String?
  status          String         @default("ACTIVE")
  impactScore     Int            @default(3)

  originMeeting  Meeting        @relation("MeetingDecisions", fields: [originMeetingId], references: [id], onDelete: Cascade)
  project        Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)

  actionItems    ActionItem[]
  followThroughs FollowThroughTracking[] @relation("TargetDecision")

  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model ActionItem {
  id          String           @id @default(cuid())
  meetingId   String
  decisionId  String?
  assigneeId  String?
  ownerId     String?
  creatorId   String?

  title       String
  description String?
  status      String           @default("OPEN")
  priority    String           @default("MEDIUM")
  dueDate     DateTime?

  meeting     Meeting          @relation("MeetingActionItems", fields: [meetingId], references: [id], onDelete: Cascade)
  decision    Decision?        @relation(fields: [decisionId], references: [id], onDelete: SetNull)
  assignee    User?            @relation("AssignedActions", fields: [assigneeId], references: [id], onDelete: SetNull)
  owner       Owner?           @relation("OwnerActionItems", fields: [ownerId], references: [id], onDelete: SetNull)
  creator     User?            @relation("CreatedActions", fields: [creatorId], references: [id], onDelete: SetNull)

  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

// ------------------------------------------------------
// Cross-Meeting Decision Follow-Through Tracking
// ------------------------------------------------------

model FollowThroughTracking {
  id              String         @id @default(cuid())
  decisionId      String
  reviewMeetingId String

  statusAtReview  String
  evidenceText    String?
  confidenceScore Float          @default(0.0)
  flaggedUnacted  Boolean        @default(false)

  decision      Decision @relation("TargetDecision", fields: [decisionId], references: [id], onDelete: Cascade)
  reviewMeeting Meeting  @relation("ReviewingMeeting", fields: [reviewMeetingId], references: [id], onDelete: Cascade)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([decisionId, reviewMeetingId])
  @@index([decisionId])
  @@index([reviewMeetingId])
}
